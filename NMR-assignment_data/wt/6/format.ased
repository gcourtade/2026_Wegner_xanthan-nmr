END
NAME		GPNAM[6]
		TEXT		"SMSQ10.100"
END
T_NAME		GPZ6
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -100.0 100.0
		REL	"GPZ6=GPZ[6]"
		INV_REL	"GPZ[6]=GPZ6"
		UNIT	"%"
		FORMAT	"%14.2f %"
		TEXT		"-2%"
END
T_NAME		P16
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1.0e10
		REL	"P16=P[16]"
		INV_REL	"P[16]=P16"
		UNIT	"usec"
		FORMAT	"%14.4f usec"
		TEXT		"homospoil/gradient pulse                         [1 msec]"
END
HEADER		"======== F1 INDIRECT DIMENSION ========"
T_NAME		td1
		TYPE	I32
		CLASS	ACQU
		SUBRANGE 1 2.14748e09
		REL	"td1=400"
		FORMAT	"%d"
		TEXT	"F1 Time domain size"
		NONEDIT
END
T_NAME		sw_F1
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0 1e38
		REL	"sw_F1=179.999099"
		UNIT	"ppm"
		FORMAT	"%f"
		TEXT	"F1 Sweep width [ppm]"
		NONEDIT
END
