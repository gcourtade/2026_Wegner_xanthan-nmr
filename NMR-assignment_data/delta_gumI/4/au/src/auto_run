int diffusion_setup(const char *curdat)

/* enter maximum gradient in CNST 11 */
{
int td1;
float cnst11;
char command[128];
char filename[PATH_MAX];
FILE *logfile;

GETCURDATA; 
sprintf(filename,"%s",ACQUPATH("automationlog.txt"));
logfile=fopen(filename,"a");

FETCHPAR1("TD",&td1);
FETCHPAR("CNST 11",&cnst11);
if ((cnst11<10) || (cnst11>95))
  {
    fprintf(logfile," DOSY setup error: max gradient strength (CNST11) is %5.1f %%. Setting to 50%%.\n",cnst11);
  	cnst11=50;
  	STOREPAR("CNST 11",cnst11);
  }
sprintf(command,"xau dosy 5 %5.1f %u l n n",cnst11,td1);
fprintf(logfile," DOSY setup:  xau dosy 5 %5.1f %u l n n\n",cnst11,td1);
XCMD(command);
fclose(logfile);
return(0);
}


