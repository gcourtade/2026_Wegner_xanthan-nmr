int set_carrierfrequency(const char *curdat)

{
int l26,l25, AU_err;
float o1;
char solvent[100],filename[PATH_MAX];
FILE *logfile;

GETCURDATA;
sprintf(filename,"%s",ACQUPATH("automationlog.txt"));
logfile=fopen(filename,"a");
fprintf(logfile,"O1 adjustment:\t");

FETCHPAR("L 25",&l25);
FETCHPAR("L 26",&l26);
FETCHPAR("SOLVENT",solvent);



if (l26==2)
   {
      	XCMD("o1calib.bruker_TS4");  /* should use o1calib.bruker , but that is sometimes not working properly (O1 not within range of default +/-5Hz */
        fprintf(logfile,"o1calib.bruker_TS4 executed\n");
   }
  else if (l26==3)
   {
     XMAC("set_O1");
     fprintf(logfile,"set_O1 executed\n");
   }
  else if ((l26==1) && ((strstr(solvent,"H2O+D2O")!=NULL) || (strstr(solvent,"Urine")!=NULL) || (strstr(solvent,"Plasma")!=NULL) || (strstr(solvent,"D2O")!=NULL)))
   {
     XCMD("o1calib.bruker_TS4"); 
     fprintf(logfile,"o1calib.bruker_TS4 executed\n");
  }
  else
    {
    fprintf(logfile,"none \n");    	
    }
 
 if (l25==2)
   {
   	FETCHPAR("O 1",&o1);
   	STOREPAR("O 2",o1);
   	fprintf(logfile,"O2 set equal to O1\n");
   }
 fclose(logfile);
 return(0);
}


