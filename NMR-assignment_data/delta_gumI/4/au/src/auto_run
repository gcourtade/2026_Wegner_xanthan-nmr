int AQ_setup(const char *curdat)

/* enter maximum allowed AQ in CNST 12 */
{
float aqmax,aqset;
char filename[PATH_MAX];
FILE *logfile;

GETCURDATA;
sprintf(filename,"%s",ACQUPATH("automationlog.txt"));
logfile=fopen(filename,"a");
fprintf(logfile,"AQ checked: ");

FETCHPAR("AQ",&aqset);
FETCHPAR("CNST 12",&aqmax);

if (aqset>aqmax)
  {
  	STOREPAR("AQ",aqmax); 
    fprintf(logfile,"AQ in parameter set = %5.1f. Value reduced to %5.1f \n",aqset,aqmax);
  }
 else
  {
  	fprintf(logfile,"AQ in parameter set = %5.1f <= max AQ of %5.1f. No change. \n",aqset,aqmax);
  }
}
  	

