int shim(const char *curdat)

{
  int l27,dz,z;
  float cnst13;
  char command[100],filename[PATH_MAX],usera4[128];
  FILE *logfile;
  
  GETCURDATA;
  sprintf(filename,"%s",ACQUPATH("automationlog.txt"));
  logfile=fopen(filename,"a");
  FETCHPAR("USERA4",usera4);
  
  FETCHPAR("L27",&l27);
  
  if (l27==2)   
    {

    	XAU("auto_TOPSHIM","");
    	fprintf(logfile,"TOPSHIM 1D executed\n");
    	/* AUERR=Proc_err(INFO_OPT, " 1D topshim executed."); */
    }
   else if (l27==3)
    {
    	XAU("auto_TOPSHIM","3d");
    	XAU("auto_TOPSHIM","");
     	fprintf(logfile,"TOPSHIM 3D & 1D executed\n");
   	/* AUERR=Proc_err(INFO_OPT, " 3D & 1D topshim executed."); */
    }
    else if (l27==4)
    {
    	XAU("auto_TOPSHIM","zrange=0.4 ordmax=3");
    	XAU("auto_TOPSHIM","zrange=0.8 ordmax=5");
    	XAU("auto_TOPSHIM","");
     	fprintf(logfile,"TOPSHIM with increasing zrange and ordmax executed\n");
   	}

  if (strstr(usera4,"shimcorr")!=NULL)
    {
     AUTOSHIM_OFF;
     FETCHPAR("CNST13",&cnst13);
     dz=round(cnst13);
AUERR = GetBsmsIntValue(BSMS_Z, &z);
AUERR = PutBsmsIntValue(BSMS_Z, &z);
   /*  PUTBSMSVAL(BSN_Z,z+dz); */
     fprintf(logfile,"SHIMCORR: added %u to z-shim\n",dz);
    }
   else
    {
     AUTOSHIM_ON; 
     fprintf(logfile,"AUTOSHIM on\n");
    }
    
   fclose(logfile);
   return 0;
}

