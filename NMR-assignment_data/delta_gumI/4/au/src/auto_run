int set_pulsewidths(const char *curdat)

{
int l28;
float p1,p3;
char filename[PATH_MAX];
FILE *logfile;

GETCURDATA;
sprintf(filename,"%s",ACQUPATH("automationlog.txt"));
logfile=fopen(filename,"a");
fprintf(logfile,"PULSE ANGLE adjustment:\t");

FETCHPAR("L 28",&l28);

if (l28==1)
  {
  GETPROSOL;
  fprintf(logfile,"GETPROSOL executed\n");
  }
 else if (l28==2)
  {
  XCMD("pulsecal.aal_TS4 quiet");
  fprintf(logfile,"pulsecal.aal_TS4 executed\n");
  FETCHPAR("P 1",&p1);
  STOREPAR("P 1",p1+0.225);     /* Offset in pulse length calibrated by Finn Aachmann November 2024 */
  }
 else if (l28==3)
  {
  XCMD("pulsecal.aal_TS4 sn quiet")
  fprintf(logfile,"pulsecal.aal sn executed\n");
  FETCHPAR("P 1",&p1);
  STOREPAR("P 1",p1+0.225);     
  }
 else if (l28==4)
  {
   XMAC("set_P1");
   fprintf(logfile,"set_P1 executed\n");
 }
 else if (l28==5)
 {
 	 XMAC("set_P1");
   fprintf(logfile,"set_P1 executed\n");
   XCMD("wvm -a")
 }
  
/* If p1 and p3 are less then 0.1u apart, any line with (center (p1 phX):f1 (p3 phY):f2) will lead to an error and aborted acquisition. This is checked here and "repaired
by just adding a few us to the proton pulse */

FETCHPAR("P 1",&p1);
FETCHPAR("P 3",&p3);
		/* sprintf(text,"before correction:\n p1= %5.2f\t p3= %5.2f \n\n",p1,p3);
		AUERR=Proc_err(ERROPT_AK_CAN, text); */

if ((abs((p1-p3))<(0.1)) && (p1<p3))	/*p1 is smaller than p3 by less than 10u */
  {
  p1=p3-0.1;		/*set p1 to p3-10u */
  STOREPAR("P 1",p1);
  fprintf(logfile,"\t P1 modified to prevent p1=p3\n");
  }
 else if ((abs((p1-p3))<(0.1)) && (p1>=p3)) /*p1 is equal to or bigger than p3 by less than 10u */
  {
  p1=p3+0.1;		/*set p1 to p3+10u */
  STOREPAR("P 1",p1);
  fprintf(logfile,"\t P1 modified to prevent p1=p3\n");
  }  
		/* FETCHPAR("P 1",&p1);
		FETCHPAR("P 3",&p3);
		sprintf(text,"after correction:\n p1= %5.2f\t p3= %5.2f \n\n",p1,p3);
		AUERR=Proc_err(ERROPT_AK_CAN, text); */
fclose(logfile);
return(0);
}


